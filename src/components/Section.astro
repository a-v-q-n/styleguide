---
import Band from "./Band.astro";
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  surface?: "grid" | "plain" | "tint";
  bordered?: boolean;
}
const { eyebrow, title, id, surface = "plain", bordered = true } = Astro.props;
---

<Band surface={surface} bordered={bordered} id={id}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="type-titre section-title">{title}</h2>
  <div class="section-body"><slot /></div>
</Band>

<style>
  .section-title {
    margin-top: var(--space-md);
    max-width: 22ch;
  }
  .section-body {
    margin-top: var(--space-lg);
  }
</style>
