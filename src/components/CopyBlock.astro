---
// Bloc de texte/code copiable (grade, gabarit de prompt, snippet CSS).
interface Props {
  code: string;
}
const { code } = Astro.props;
---

<div class="codeblock">
  <button class="copy cb-copy" type="button" data-copy={code} aria-label="Copier">
    <span data-copy-label>copier</span>
  </button>
  <pre><code>{code}</code></pre>
</div>

<style>
  .codeblock {
    position: relative;
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }
  .cb-copy {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
  }
  pre {
    margin: 0;
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--fg);
  }
</style>
