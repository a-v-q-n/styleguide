---
// Monogramme AVQN inline en currentColor : il suit l'ambiance (encre en clair,
// papier en nocturne). Les fichiers officiels (noir / encre) vivent dans brand/assets.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls = "" } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 1024 1024"
  fill="currentColor"
  role="img"
  aria-label="AVQN"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect
    x="436.754"
    y="4.27985"
    width="906.146"
    height="168"
    transform="rotate(67.3331 436.754 4.27985)"></rect>
  <rect x="56" y="392" width="512" height="168"></rect>
  <rect y="736" width="1024" height="168"></rect>
  <rect width="1024" height="168"></rect>
  <rect y="904" width="904" height="168" transform="rotate(-90 0 904)"></rect>
  <rect x="568" y="1024" width="184" height="456" transform="rotate(-90 568 1024)"></rect>
  <rect x="856" y="904" width="904" height="168" transform="rotate(-90 856 904)"></rect>
</svg>
