---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Charte AVQN",
  description = "Le livre de marque AVQN — couleur, typographie, composants et DA image, pour l'œil et pour les agents.",
} = Astro.props;

const fullTitle = title === "Charte AVQN" ? title : `${title} — Charte AVQN`;

const nav = [
  { href: "/fondations", label: "Fondations" },
  { href: "/composants", label: "Composants" },
  { href: "/logo", label: "Logo" },
  { href: "/da-image", label: "DA image" },
];
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Geist+Mono:wght@500;600&family=Geist:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("sg-theme") === "night") {
            document.documentElement.dataset.theme = "night";
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label="Accueil — Charte AVQN">
          <Logo size={26} />
          <span class="brand-word">Charte</span>
        </a>
        <nav class="site-nav" aria-label="Sections">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="nav-link"
                aria-current={here === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <hr class="rule" />
        <div class="footer-inner">
          <div>
            <p class="eyebrow">Pour les agents</p>
            <p class="footer-lede">
              Toute la charte, lisible par une IA. Point d'entrée : <a href="/llms.txt">/llms.txt</a
              >.
            </p>
          </div>
          <ul class="exports">
            <li><a href="/llms.txt">llms.txt</a> <span>l'index complet</span></li>
            <li><a href="/tokens.json">tokens.json</a> <span>les valeurs exactes</span></li>
            <li><a href="/tokens.css">tokens.css</a> <span>à importer dans un projet web</span></li>
          </ul>
        </div>
        <p class="colophon">
          AVQN · styleguide.avqn.ch — généré depuis <code>brand/</code>, la source unique.
        </p>
      </div>
    </footer>

    <script is:inline>
      // Click-to-copy : toute puce [data-copy] copie sa valeur (délégation globale).
      document.addEventListener("click", function (e) {
        var el = e.target.closest("[data-copy]");
        if (!el || !navigator.clipboard) return;
        navigator.clipboard.writeText(el.getAttribute("data-copy")).then(function () {
          var lbl = el.querySelector("[data-copy-label]");
          var prev = lbl ? lbl.textContent : null;
          el.dataset.copied = "true";
          if (lbl) lbl.textContent = "copié";
          setTimeout(function () {
            el.dataset.copied = "false";
            if (lbl && prev !== null) lbl.textContent = prev;
          }, 1100);
        });
      });
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(8px);
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        border-bottom: 1px solid var(--rule);
      }
      .header-inner {
        display: flex;
        align-items: center;
        gap: var(--space-lg);
        min-height: 64px;
        padding-block: var(--space-sm);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6em;
        color: var(--fg);
        text-decoration: none;
        font-family: var(--font-serif);
        font-size: 1.35rem;
        line-height: 1;
      }
      .brand-word {
        letter-spacing: 0.01em;
      }
      .site-nav {
        display: flex;
        gap: clamp(0.75rem, 2.5vw, 1.75rem);
        margin-inline-start: auto;
        flex-wrap: wrap;
      }
      .nav-link {
        font-family: var(--font-mono);
        font-size: var(--text-meta);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted);
        text-decoration: none;
        padding-block: 0.35em;
        border-bottom: 2px solid transparent;
        transition: color var(--motion-vif) ease;
      }
      .nav-link:hover {
        color: var(--fg);
      }
      .nav-link[aria-current="page"] {
        color: var(--fg);
        border-bottom-color: var(--accent);
      }

      main {
        display: block;
      }

      .site-footer {
        margin-top: var(--space-2xl);
        padding-bottom: var(--space-xl);
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xl);
        justify-content: space-between;
        padding-top: var(--space-lg);
      }
      .footer-lede {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        max-width: 30ch;
        margin: 0.5em 0 0;
      }
      .exports {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.4em;
      }
      .exports a {
        font-family: var(--font-mono);
        font-size: var(--text-meta);
      }
      .exports span {
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 0.9rem;
      }
      .colophon {
        margin-top: var(--space-xl);
        color: var(--muted);
        font-size: 0.9rem;
      }
      .colophon code {
        font-family: var(--font-mono);
        font-size: 0.85em;
      }

      @media (max-width: 640px) {
        .header-inner {
          flex-wrap: wrap;
          gap: var(--space-md);
        }
        .site-nav {
          order: 3;
          width: 100%;
          margin-inline-start: 0;
        }
      }
    </style>
  </body>
</html>
