---
import Base from "../../layouts/Base.astro";
import Band from "../../components/Band.astro";
import Section from "../../components/Section.astro";
import CopyBlock from "../../components/CopyBlock.astro";
import DoctrineLink from "../../components/DoctrineLink.astro";
import MediaNav from "../../components/MediaNav.astro";
import color from "../../../brand/tokens/color.json";
import manifest from "../../../brand/assets/exemples/manifest.json";

const grade =
  "shot on 35mm film, fine film grain, subtle halation on highlights, muted desaturated Kodak color palette, warm blacks (#211C17), cream highlights (#FAF8F3), soft directional light, shallow depth of field, carefully composed editorial frame, no readable text anywhere, no frame line, no border";

const gabarit =
  "Cinematic editorial photograph, vertical composition + [la scène contemporaine : sujet, action, moment — dire aussi ce qui est absent] + [la direction de couleur, si elle sert le propos] + [l'objet vermillon et son sens] + [la touche futur discrète] + [le grade commun]";

const recetteHex = color.recettes as Record<string, string>;

const usages = [
  { titre: "B-rolls vidéo", items: manifest.photo.filter((g) => g.usage === "b-roll") },
  { titre: "Posts LinkedIn", items: manifest.photo.filter((g) => g.usage === "post-linkedin") },
];
const recettes = [
  { key: "ardoise", light: "nuit, heure bleue", counter: "tungstène ambré des lampes" },
  { key: "ambre", light: "matin, soleil rasant", counter: "une ombre ardoise froide" },
  { key: "sauge", light: "plein jour, végétal", counter: "bois et terre argile" },
  { key: "argile", light: "intérieur doré, humain", counter: "crème et blancs cassés" },
  { key: "prune", light: "crépuscule, focus", counter: "une lueur chaude (lampe, écran)" },
];
---

<Base
  title="Image photo"
  description="« L'anticipation douce » : la direction artistique des images AVQN — grade 35mm, recettes de lumière, vermillon sémantique."
>
  <MediaNav />
  <Band surface="grid" class="page-head">
    <p class="eyebrow">Média · Style d'image</p>
    <h1 class="type-hero">« L'anticipation douce ».</h1>
    <p class="lede">
      Le monde d'un indépendant, décalé de deux degrés vers le futur, photographié comme un film 35
      mm des années 70. Crédible d'abord, futur ensuite, rétro dans le rendu.
    </p>
  </Band>

  <Section eyebrow="01 · Le grade" title="La signature commune">
    <p class="note">
      Tout prompt image se termine par le même grade — c'est lui qui unit la banque.
    </p>
    <CopyBlock code={grade} />
    <DoctrineLink slug="da-image" />
  </Section>

  <Section eyebrow="02 · Les recettes" title="Des recettes de lumière" surface="tint">
    <p class="note">
      Cinq ambiances possibles, à choisir selon le propos — une direction artistique, pas des
      règles. Une dominante suffit ; un contrepoint enrichit souvent le plan.
    </p>
    <div class="recettes">
      {
        recettes.map((w) => (
          <article class="recette">
            <div class="recette-chip" style={`--c:${recetteHex[w.key]}`} />
            <div class="recette-body">
              <h3 class="recette-name">
                {w.key} <span class="recette-hex">{recetteHex[w.key]}</span>
              </h3>
              <p class="recette-light">{w.light}</p>
              <p class="recette-counter">contrepoint possible — {w.counter}</p>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section eyebrow="03 · Les règles" title="Vermillon, touche futur, lieux d'aujourd'hui">
    <div class="rules">
      <div class="rule-card">
        <span class="rule-swatch"></span>
        <h3 class="type-titre">Un vermillon qui désigne</h3>
        <p>
          Un seul objet vermillon <code>#E0542B</code> par image, et il désigne ce dont le propos parle
          : le carnet qu'on ouvre, la diode qui veille. Jamais décoratif.
        </p>
      </div>
      <div class="rule-card">
        <span class="rule-icon" aria-hidden="true">◵</span>
        <h3 class="type-titre">Une touche futur discrète</h3>
        <p>
          Un détail impossible aujourd'hui, dans le coin de l'image : écran bombé ambré, e-paper,
          molette intelligente. Black Mirror doux — jamais d'hologramme ni de HUD.
        </p>
      </div>
      <div class="rule-card">
        <span class="rule-icon" aria-hidden="true">◻</span>
        <h3 class="type-titre">Des lieux contemporains</h3>
        <p>
          Le rétro vit dans le rendu (grain, halation), jamais dans le décor. Intérieurs modernes,
          lignes nettes, mobilier actuel — pas de vieilles fermes ni de poutres rustiques.
        </p>
      </div>
    </div>
  </Section>

  <Section eyebrow="04 · Le gabarit" title="Écrire un prompt" surface="tint">
    <CopyBlock code={gabarit} />
    <p class="note">
      Peu d'éléments, de l'air, un premier plan travaillé. Aucun texte lisible dans l'image — les
      mots vivent dans la mise en page.
    </p>
    <DoctrineLink slug="da-image" />
  </Section>

  <Section eyebrow="05 · La banque" title="Des images avec un propos">
    <p class="note">
      La référence du style : chaque image entre dans la banque avec son usage, la phrase qu'elle
      porte toute seule, et le prompt exact qui l'a produite — la température et le ton à répliquer.
    </p>
    {
      usages.map((u) => (
        <div class="usage">
          <h3 class="usage-titre">{u.titre}</h3>
          <div class="galerie">
            {u.items.map((g) => (
              <article class="galerie-item">
                <img
                  src={`/assets/exemples/${g.fichier}`}
                  alt={`${g.nom} — ${g.intention}`}
                  loading="lazy"
                />
                <p class="galerie-nom">{g.nom}</p>
                <p class="galerie-intention">« {g.intention} »</p>
                <details class="galerie-prompt">
                  <summary>le prompt</summary>
                  <CopyBlock code={g.prompt} />
                </details>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </Section>

  <style>
    .page-head :global(.band-inner) {
      padding-block: var(--space-2xl) var(--space-xl);
    }
    .page-head .type-hero {
      margin-top: var(--space-md);
    }
    .lede {
      margin-top: var(--space-lg);
      max-width: 54ch;
      font-family: var(--font-serif);
      font-size: var(--text-corps);
      line-height: 1.4;
    }
    .note {
      margin-bottom: var(--space-lg);
      color: var(--muted);
      max-width: 62ch;
    }
    .note:last-child {
      margin-bottom: 0;
      margin-top: var(--space-lg);
    }
    .recettes {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: var(--space-lg);
    }
    .recette {
      display: flex;
      gap: var(--space-md);
      align-items: stretch;
      border: 1px solid var(--rule);
      border-radius: var(--radius-md);
      padding: var(--space-md);
    }
    .recette-chip {
      flex: none;
      width: 56px;
      border-radius: var(--radius-sm);
      background: var(--c);
    }
    .recette-name {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      margin: 0;
      text-transform: capitalize;
      display: flex;
      align-items: baseline;
      gap: 0.5em;
    }
    .recette-hex {
      font-family: var(--font-mono);
      font-size: var(--text-meta);
      color: var(--muted);
      text-transform: none;
    }
    .recette-light {
      margin: 0.3em 0 0;
      color: var(--fg);
    }
    .recette-counter {
      margin: 0.2em 0 0;
      color: var(--muted);
      font-size: 0.95rem;
    }
    .rules {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-lg);
    }
    .rule-card {
      border: 1px solid var(--rule);
      border-radius: var(--radius-md);
      padding: var(--space-lg);
      display: grid;
      gap: 0.6em;
      align-content: start;
    }
    .rule-card p {
      margin: 0;
      color: var(--muted);
    }
    .rule-card code {
      font-family: var(--font-mono);
      font-size: 0.85em;
      color: var(--accent);
    }
    .rule-swatch {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
      background: var(--color-vermillon);
    }
    .rule-icon {
      font-size: 2rem;
      color: var(--accent);
      line-height: 1;
    }
    .usage {
      margin-top: var(--space-xl);
    }
    .usage-titre {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      font-weight: 400;
      margin: 0 0 var(--space-md);
    }
    .galerie {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: var(--space-lg);
    }
    .galerie-item img {
      width: 100%;
      height: auto;
      border: 1px solid var(--rule);
      border-radius: var(--radius-sm);
    }
    .galerie-nom {
      margin: var(--space-sm) 0 0;
      font-family: var(--font-mono);
      font-size: var(--text-meta);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
    }
    .galerie-intention {
      margin: 0.25em 0 0;
      font-family: var(--font-serif);
      font-size: 1.2rem;
      line-height: 1.3;
    }
    .galerie-prompt {
      margin-top: var(--space-sm);
    }
    .galerie-prompt summary {
      cursor: pointer;
      font-family: var(--font-mono);
      font-size: var(--text-meta);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
    }
    .galerie-prompt[open] summary {
      color: var(--fg);
    }
    @media (max-width: 640px) {
      .rules {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
