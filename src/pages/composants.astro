---
import Base from "../layouts/Base.astro";
import Band from "../components/Band.astro";
import Section from "../components/Section.astro";
import CopyToken from "../components/CopyToken.astro";
import DoctrineLink from "../components/DoctrineLink.astro";
import Duo from "../components/Duo.astro";
import DemoBoutons from "../components/demos/DemoBoutons.astro";
import DemoCartes from "../components/demos/DemoCartes.astro";
import DemoGestes from "../components/demos/DemoGestes.astro";
import DemoChamps from "../components/demos/DemoChamps.astro";
import DemoFormulaire from "../components/demos/DemoFormulaire.astro";
import DemoTableau from "../components/demos/DemoTableau.astro";
import DemoFiltres from "../components/demos/DemoFiltres.astro";
import DemoNotifs from "../components/demos/DemoNotifs.astro";
import DemoBadges from "../components/demos/DemoBadges.astro";
import DemoNav from "../components/demos/DemoNav.astro";
import DemoPagination from "../components/demos/DemoPagination.astro";
import DemoVide from "../components/demos/DemoVide.astro";
import DemoChargement from "../components/demos/DemoChargement.astro";
import DemoModale from "../components/demos/DemoModale.astro";

// Les familles, dans l'ordre de la doctrine (brand/doctrine/composants-web.md).
const familles: {
  eyebrow: string;
  title: string;
  demo: any;
  classes: string[];
  note: string;
  tint?: boolean;
}[] = [
  {
    eyebrow: "01 · Boutons",
    title: "Une forme, trois rangs",
    demo: DemoBoutons,
    classes: [".btn .btn--primary", ".btn .btn--secondary", ".btn .btn--ghost"],
    note: "Un seul primaire vermillon par vue. Focus clavier toujours visible (anneau vermillon), jamais supprimé. Pas d'ombre, pas de dégradé, coins nets.",
  },
  {
    eyebrow: "02 · Cartes",
    title: "Des surfaces sobres",
    demo: DemoCartes,
    classes: [".card", ".card .card--raised"],
    note: "Bordure 1 px, radius medium, padding large. Flat par défaut ; raised seulement pour flotter.",
    tint: true,
  },
  {
    eyebrow: "03 · Gestes-signature",
    title: "Ce qui signe la marque",
    demo: DemoGestes,
    classes: [".eyebrow", ".filet", "em / .acc", ".rule"],
    note: "Le filet vermillon et l'eyebrow comptent comme l'accent unique : une catégorie réelle, jamais un ornement.",
  },
  {
    eyebrow: "04 · Champs & liens",
    title: "Le champ nu, le lien qui porte",
    demo: DemoChamps,
    classes: [".field", ".input"],
    note: "Fond --bg, bordure 1 px --rule, focus en anneau. Le lien est vermillon, souligné à l'épaisseur du texte.",
  },
  {
    eyebrow: "05 · Formulaires",
    title: "La saisie, assemblée",
    demo: DemoFormulaire,
    classes: [".form", ".form-group", ".field--error", ".select", ".check"],
    note: "Label au-dessus, aide dessous, l'erreur vermillon collée à sa cause — pas de rôle danger, pas de vert de succès. Les coches sont l'accent de la vue.",
  },
  {
    eyebrow: "06 · Tableaux",
    title: "La donnée au filet",
    demo: DemoTableau,
    classes: [".table", ".table--compact", ".num"],
    note: "En-tête meta, filets 1 px, pas de zébrage. Numérique à droite en chiffres tabulaires ; l'action fantôme reste visible, rien ne surgit au survol.",
  },
  {
    eyebrow: "07 · Filtres",
    title: "L'état, pas le décor",
    demo: DemoFiltres,
    classes: [".chip", ".seg", ".input"],
    note: "L'actif s'inverse franchement (fond --fg, texte --bg) : plusieurs filtres actifs sans disputer le vermillon à la vue.",
    tint: true,
  },
  {
    eyebrow: "08 · Notifications",
    title: "Du fugace à l'ancré",
    demo: DemoNotifs,
    classes: [".toast", ".banner .banner--action", ".alert"],
    note: "Toast inversé en bas à droite, 5 s, un seul à la fois. La bannière persiste jusqu'à résolution — liseré vermillon si une action est requise.",
  },
  {
    eyebrow: "09 · Badges de statut",
    title: "Une pastille, un label",
    demo: DemoBadges,
    classes: [".badge", ".badge--vivant"],
    note: "Les neutres reculent en gris ; le vivant porte le vermillon. Jamais plus d'un badge vermillon par ligne.",
  },
  {
    eyebrow: "10 · Navigation applicative",
    title: "Tenir le cap sans crier",
    demo: DemoNav,
    classes: [".app-bar", ".app-nav", ".app-foot"],
    note: "Wordmark serif, sections en mono, l'actif souligné vermillon — l'accent de la vue. Un seul niveau dans le header, un footer qui ferme.",
  },
  {
    eyebrow: "11 · Pagination",
    title: "La position d'un coup d'œil",
    demo: DemoPagination,
    classes: [".pager", ".pager-arrow"],
    note: "Mono ; la page courante en --fg demi-grasse, les flèches fantômes. En butée : opacité 45 %.",
  },
  {
    eyebrow: "12 · États vides",
    title: "Le vide qui invite",
    demo: DemoVide,
    classes: [".empty", ".empty-note"],
    note: "Un titre qui constate, une phrase qui invite, une seule action — le primaire de la vue.",
    tint: true,
  },
  {
    eyebrow: "13 · Chargement",
    title: "Attendre dans la matière",
    demo: DemoChargement,
    classes: [".skeleton", ".skeleton--bloc", ".spinner"],
    note: "Pulsation douce (--motion-souffle), pas de shimmer. Le spinner ne porte pas de sens : jamais vermillon. Pas de pourcentages inventés.",
  },
  {
    eyebrow: "14 · Modales",
    title: "Un voile d'encre",
    demo: DemoModale,
    classes: [".modal-veil", ".modal", ".modal-close"],
    note: "Voile encre 40 % dans les deux ambiances, un primaire max au pied, Échap et croix ferment toujours. Une modale à la fois.",
  },
];
---

<Base
  title="Composants"
  description="La charte AVQN portée à l'interface : toute la bibliothèque de composants, en clair et en nocturne."
>
  <Band surface="grid" class="page-head">
    <p class="eyebrow">Composants</p>
    <h1 class="type-hero">La charte, en interface.</h1>
    <p class="lede">
      Tout hérite des rôles sémantiques (<code>--bg</code>, <code>--fg</code>, <code>--accent</code
      >) : chaque famille est montrée deux fois — dans l'ambiance du site et en nocturne forcé —
      sans une ligne de code dédiée.
    </p>
    <DoctrineLink slug="composants-web" />
  </Band>

  {
    familles.map((f) => (
      <Section eyebrow={f.eyebrow} title={f.title} surface={f.tint ? "tint" : "plain"}>
        <Duo demo={f.demo} />
        <div class="classes">
          {f.classes.map((c) => (
            <CopyToken value={c} />
          ))}
        </div>
        <p class="note">{f.note}</p>
      </Section>
    ))
  }
</Base>

<style>
  .page-head :global(.band-inner) {
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .page-head .type-hero {
    margin-top: var(--space-md);
    max-width: 16ch;
  }
  .lede {
    margin-top: var(--space-lg);
    max-width: 54ch;
    font-family: var(--font-serif);
    font-size: var(--text-corps);
    line-height: 1.4;
  }
  .lede code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--accent);
  }
  .classes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
  .note {
    margin-top: var(--space-lg);
    color: var(--muted);
    max-width: 60ch;
  }
</style>
